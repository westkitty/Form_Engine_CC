{
  "name": "form-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "vite build --mode artifact",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "proxy": "node server/reconstruction-proxy.mjs",
    "test:artifact": "vite build --mode artifact && node tests/e2e/artifact-check.mjs",
    "fetch:samples": "mkdir -p test-results/external && curl -sSL -o test-results/external/Duck.glb https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Assets/main/Models/Duck/glTF-Binary/Duck.glb && curl -sSL -o test-results/external/BoxTextured.glb https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Assets/main/Models/BoxTextured/glTF-Binary/BoxTextured.glb"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "playwright": "^1.56.1",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
